# ============================================================
# Клиентские переменные (Vite подставляет их в бандл фронтенда).
# Значения: Firebase Console -> Project settings -> Your apps -> Web app
# Скопируйте этот файл в .env и заполните.
# ============================================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ============================================================
# Серверные переменные (этап 2+).
# Задаются в Netlify (Site configuration -> Environment variables) и локально
# в .env для `netlify dev`. В клиентский бандл НЕ попадают (нет префикса VITE_).
# ============================================================

# JSON сервис-аккаунта Firebase, закодированный в base64 (Admin SDK в функциях).
# Console -> Project settings -> Service accounts -> Generate new private key.
FIREBASE_SERVICE_ACCOUNT=

# 32 байта в base64 — ключ AES-256-GCM для шифрования IG-токенов. `openssl rand -base64 32`
TOKEN_ENCRYPTION_KEY=
# Секрет для HMAC-подписи OAuth-state (CSRF). `openssl rand -base64url 32` или любой 32+ байтный секрет
OAUTH_STATE_SECRET=

# Instagram-приложение (Meta for Developers -> App -> Instagram):
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Redirect URI — ТОЧНОЕ совпадение с настройкой в Meta. Прод: https://<site>/api/instagram-callback
OAUTH_REDIRECT_URI=http://localhost:8888/api/instagram-callback
# Базовый URL приложения для возврата после OAuth:
APP_URL=http://localhost:8888

# AI-ответы (этап 5):
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Вебхуки Instagram (этап 5) — эту же строку вписать в Meta App -> Webhooks -> Verify token:
META_WEBHOOK_VERIFY_TOKEN=

# Необязательное:
# INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_content_publish,instagram_business_manage_comments
#   (+ ,instagram_business_manage_messages для директа — этап 6, после App Review)
# INSTAGRAM_WEBHOOK_FIELDS=comments   (поставьте comments,messages, чтобы включить директ)
# TOKEN_REFRESH_WINDOW_DAYS=15
